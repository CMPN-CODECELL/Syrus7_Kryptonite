rules_version = '2';
// QuantFolio keeps every document behind the Cloud Run API, which uses its own service account (IAM, not these
// rules). Browsers never talk to Firestore directly, so the client SDK path is closed to everyone.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
