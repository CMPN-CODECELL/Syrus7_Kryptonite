# Environment of the Cloud Run API service and the worker job. NAMES ONLY: values are set by
# scripts\gcp\deploy-api.ps1 / deploy-worker.ps1, and the secret comes from Secret Manager. Never commit values.

# --- where things live (both)
QF_GCP_PROJECT=
QF_GCP_REGION=
QF_BUCKET=
QF_FIRESTORE_DB=
QF_WORKER_JOB=

# --- secret (both): Secret Manager "qf-ip-salt", mounted with --set-secrets QF_IP_SALT=qf-ip-salt:latest
QF_IP_SALT=

# --- abuse protection and compute control (both read them)
QF_DAILY_RUN_CAP=
QF_USER_DAILY_RUN_CAP=
QF_USER_ACTIVE_CAP=
QF_QUEUE_CAPACITY=
QF_COMPUTE_ENABLED=
QF_RETENTION_DAYS=

# --- API service only
QF_ALLOWED_HOSTS=
QF_CLIENT_IP_SOURCE=
QF_SWEEP_SA=
QF_SWEEP_AUDIENCE=
QF_LIVE_STREAM_MAX_S=

# --- worker job only
QF_WORKER_BUDGET_S=
QF_EXPERIMENT_TIMEOUT_S=

# --- never set in the cloud (IBM hardware stays off; the image does not read .env files)
# IBM_QUANTUM_TOKEN=
# IBM_QUANTUM_INSTANCE=
