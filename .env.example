# QuantFolio settings. Copy to ".env" (scripts\setup.ps1 does this) and edit.
# Every value is optional: with an empty file the app runs on 127.0.0.1:8000
# with the bundled dataset and the local Aer simulator. The only outbound
# connection is the live price ticker (Yahoo Finance, display only); set
# QF_LIVE_QUOTES=0 to run fully offline.
# Never commit ".env".

# --- Server ---------------------------------------------------------------
# QF_API_HOST=127.0.0.1          # keep on localhost; there is no authentication
# QF_API_PORT=8000
# QF_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173   # dev server only
# QF_LOG_LEVEL=INFO

# --- Storage (defaults live inside the project folder) ----------------------
# QF_DATA_DIR=                   # default <project>\data
# QF_STATE_DIR=                  # default <QF_DATA_DIR>\state  (SQLite job store, PID file)
# QF_RUNS_DIR=                   # default <QF_DATA_DIR>\runs   (results and reports)

# --- Jobs -------------------------------------------------------------------
# QF_QUEUE_CAPACITY=8            # queued + running jobs accepted before 429
# QF_EXPERIMENT_TIMEOUT_S=3600
# QF_PIPELINE_IMPL=real          # "fake" = deterministic test pipeline (tests, load tests)

# --- Live prices (ticker and chart; display only, never used by a run) -------
# QF_LIVE_QUOTES=1               # 0 = no outbound connection; the ticker shows stored closes
# QF_LIVE_IDLE_S=60              # stop the Yahoo feed this long after the last viewer leaves
# QF_LIVE_STREAM_MAX_S=900       # end each browser stream after this long; it reconnects

# --- Optional IBM Quantum (not needed; never used by tests or the web UI) ----
# Leave empty to stay local. The token is read only by the API process, is
# never logged or returned, and is not passed to the job worker.
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
